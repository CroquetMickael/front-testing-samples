{
  "name": "front-testing-samples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "microcks": "node testing-sample/microcks/start.ts",
    "test:vitest-browser": "vitest --config testing-sample/vitest-browser/vitest.config.ts",
    "test:playwright-ct": "playwright test -c testing-sample/playwright-ct/playwright-ct.config.ts --pass-with-no-tests",
    "test:playwright-e2e": "playwright test -c testing-sample/playwright-e2e/playwright.config.ts --pass-with-no-tests",
    "test:playwright-bdd": "bddgen -c testing-sample/playwright-bdd/playwright.config.ts && playwright test -c testing-sample/playwright-bdd/playwright.config.ts --pass-with-no-tests",
    "test:vitest-cucumber": "vitest --config testing-sample/vitest-cucumber/vitest.config.ts",
    "test:vitest-cucumber-browser": "vitest --config testing-sample/vitest-cucumber-browser/vitest.config.ts",
    "test:all": "npm run test:vitest-browser -- --run && npm run test:playwright-ct && npm run test:vitest-cucumber -- --run && npm run test:vitest-cucumber-browser -- --run && npm run test:playwright-e2e && npm run test:playwright-bdd"
  },
  "dependencies": {
    "@axa-fr/canopee-css": "^1.8.0",
    "@axa-fr/canopee-react": "^1.8.0",
    "@material-symbols/svg-400": "^0.47.6",
    "@material-symbols/svg-700": "^0.47.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@microcks/microcks-testcontainers": "^0.3.5",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright": "1.62.1",
    "playwright-bdd": "^9.2.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
